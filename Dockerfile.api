FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/requirements-api.txt /tmp/requirements-api.txt
RUN python -m pip install --upgrade pip && python -m pip install -r /tmp/requirements-api.txt

COPY backend/ /app/backend/
COPY data/ /app/data/
COPY app_core/ /app/app_core/

EXPOSE 8012

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8012", "--workers", "2"]
